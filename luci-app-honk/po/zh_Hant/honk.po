msgid "Select the packages to upgrade:"
msgstr "選擇要升級的套件："

#: htdocs/luci-static/resources/honk/nativeapi.js:115
msgid "Set experimental.native_api.config_write to true."
msgstr "將 experimental.native_api.config_write 設為 true。"

#: htdocs/luci-static/resources/honk/nativeapi.js:113
msgid "Set experimental.native_api.enabled to true."
msgstr "將 experimental.native_api.enabled 設為 true。"

#: htdocs/luci-static/resources/honk/nativeapi.js:117
msgid "Set experimental.native_api.password_auth to true or set experimental.native_api.secret."
msgstr "將 experimental.native_api.password_auth 設為 true，或設定 experimental.native_api.secret。"

#: htdocs/luci-static/resources/honk/nativeapi.js:119
msgid "Set global.data_dir to %s."
msgstr "將 global.data_dir 設為 %s。"

#: htdocs/luci-static/resources/honk/service.js:1015
msgid "Start at boot"
msgstr "開機自動啟動"

#: htdocs/luci-static/resources/honk/service.js:901
msgid "Start at boot is off"
msgstr "已關閉開機自動啟動"

#: htdocs/luci-static/resources/honk/service.js:901
msgid "Start at boot is on"
msgstr "已開啟開機自動啟動"

#: htdocs/luci-static/resources/honk/service.js:900
msgid "Start at boot is on; %s no longer starts at boot, because dae and honk cannot run at the same time."
msgstr "已開啟開機自動啟動。dae 和 honk 不能同時執行，%s 不再開機自動啟動。"

#: htdocs/luci-static/resources/honk/service.js:1016
msgid "Starts automatically when the router boots; does not change whether it is running now."
msgstr "路由器開機時自動啟動；不影響目前是否正在執行。"

#: htdocs/luci-static/resources/honk/service.js:796
msgid "These packages were not upgraded: %s"
msgstr "以下套件未升級：%s"

#: htdocs/luci-static/resources/honk/service.js:633
msgid "To use this feed's version, run %s; other packages can be added to the same command."
msgstr "如需改用本軟體源的版本，請執行 %s；其他套件可加入同一條命令。"

#: htdocs/luci-static/resources/honk/service.js:904
msgid "Unable to change Start at boot: %s"
msgstr "無法變更開機自動啟動：%s"

#: htdocs/luci-static/resources/honk/service.js:447
msgid "Unable to read %s: %s"
msgstr "無法讀取 %s：%s"

#: htdocs/luci-static/resources/honk/service.js:821
msgid "Unable to read upgrade status. The job may still be running; reload to reconnect."
msgstr "無法讀取升級狀態。工作可能仍在執行；請重新載入頁面以恢復連線。"

#: htdocs/luci-static/resources/honk/service.js:1001
