msgid "Upgrade"
msgstr "升級"

#: htdocs/luci-static/resources/honk/service.js:808
msgid "Upgrade complete."
msgstr "升級完成。"

#: htdocs/luci-static/resources/honk/service.js:689
msgid "Upgrading %s restarts the service and interrupts connections for a few seconds; upgrading only the other packages reloads it. Continue?"
msgstr "升級 %s 會重新啟動服務，連線將中斷數秒；只升級其他套件則改為重新載入。是否繼續？"

#: htdocs/luci-static/resources/honk/service.js:707
#: htdocs/luci-static/resources/honk/service.js:786
msgid "Upgrading…"
msgstr "正在升級…"

#: htdocs/luci-static/resources/honk/service.js:1007
msgid "Version"
msgstr "版本"

#: htdocs/luci-static/resources/honk/service.js:827
msgid "Waiting for the package manager to reconnect…"
msgstr "正在等待套件管理員重新連線…"

