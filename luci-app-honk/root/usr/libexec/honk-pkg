#!/bin/sh

# Only this helper may invoke apk on behalf of the honk LuCI application.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

. /usr/share/libubox/jshn.sh

LOCK=/tmp/honk-pkg.lock
STATE=/tmp/honk-pkg.json
LOG=/tmp/honk-pkg.log
RC=/tmp/honk-pkg.rc

# 本仓库 CI 发布的 apk 软件源（apk 分支，按架构分目录，索引用 key/key-build.pem 签名）
HONK_REPO_BASE=https://raw.githubusercontent.com/MinimaxFlora/luci-app-honk/apk
HONK_REPO_FILE=/etc/apk/repositories.d/honk.list
APK_KEYS_DIR=/etc/apk/keys

fail() {
	printf '%s\n' "$*" >&2
	exit 1
}

valid_app() {
	case "$1" in
		honk) return 0 ;;
		*) return 1 ;;
	esac
}

valid_package() {
	case "$1" in
		honk|luci-app-honk)
			return 0 ;;
		luci-i18n-honk-zh-cn|luci-i18n-honk-zh-tw)
			return 0 ;;
		v2ray-geoip|v2ray-geosite)
			return 0 ;;
		*) return 1 ;;
	esac
}

load_json() {
	# json_load() itself does not propagate jshn parse failures.
	json_script=$(jshn -r "$1") || return 1
	eval "$json_script"
}

query_installed() {
	/usr/bin/apk --interactive=no --progress=no query --network=no \
		--installed --from installed --fields name,version --format json "$@"
}

# 和 passwall 一样：版本从 GitHub Releases API 拿，安装是下载 release 里的 .apk
# 再 apk add --allow-untrusted。完全不碰系统包索引，镜像坏掉也影响不到检查。
HONK_GH_REPO=MinimaxFlora/luci-app-honk

# 可选代理前缀（passwall 的 GitHub Proxy 同理）：uci set honk.config.gh_proxy=...
# 值形如 'https://gh-proxy.org/'，拼在 api/download 地址前面。
gh_proxy() {
	uci -q get honk.config.gh_proxy 2>/dev/null
}

fetch_release() {
	api="$(gh_proxy)https://api.github.com/repos/$HONK_GH_REPO/releases/latest"
	file=$(mktemp /tmp/honk-gh.XXXXXX) || return 1
	if ! wget -q -T 25 -O "$file" "$api" 2>/dev/null || [ ! -s "$file" ]; then
		rm -f "$file"
		printf '%s\n' "Unable to reach $api" >&2
		return 1
	fi
	printf '%s' "$file"
}

# 已装版本摊成 "名字 版本" 的文本：jshn 有状态，拼输出 JSON 时不能再 json_load
build_installed_table() {
	INSTALLED_TABLE=$(mktemp /tmp/honk-installed.XXXXXX) || return 1
	installed_json=$(query_installed "$@") || return 1
	json_init
	json_load "{\"list\":$installed_json}" || return 1
	json_select list || return 1
	i=1
	while json_select "$i" 2>/dev/null; do
		json_get_var name name
		json_get_var version version
		printf '%s %s\n' "$name" "$version" >> "$INSTALLED_TABLE"
		json_select ..
		i=$((i + 1))
	done
	return 0
}

# 版本比较自己算（apk version -t 不认带 - 的串，rc=1 且不输出）：
# 归一化——把非字母数字的字符都当成分隔符，再逐段比，数字段按数值、其它按字典序。
# 这样 26.316.12162~af54e6a-r1（已装）和 26.316.12162-af54e6a-r1（release tag）算相等。
version_cmp() {
	awk -v a="$1" -v b="$2" 'BEGIN {
		na = a; gsub(/[^0-9A-Za-z]+/, ".", na)
		nb = b; gsub(/[^0-9A-Za-z]+/, ".", nb)
		n = split(na, x, "."); m = split(nb, y, ".")
		k = (n > m ? n : m)
		for (i = 1; i <= k; i++) {
			p = (i <= n && x[i] != "") ? x[i] : "0"
			q = (i <= m && y[i] != "") ? y[i] : "0"
			if (p ~ /^[0-9]+$/ && q ~ /^[0-9]+$/) {
				if (p + 0 > q + 0) { print 1; exit }
				if (p + 0 < q + 0) { print -1; exit }
			} else {
				if (p > q) { print 1; exit }
				if (p < q) { print -1; exit }
			}
		}
		print 0
	}'
}

# 输出每行：name <TAB> version <TAB> download_url
# 版本以 release 的 tag 为准（GitHub 会把资产名里的 ~ + 换成 .，不能拿资产名解版本）；
# 只列「已安装 + 有更新」的包；vmlinux-btf 因为锁内核，不参与自动更新
release_updates() {
	# 后台作业（upgrade/install）里没人调 repo_setup，REPO_ARCH 会是空的，
	# 那样 "<包名>-…-<架构>.apk" 永远匹配不上，只能得到“没有更新”
	[ -n "${REPO_ARCH:-}" ] || repo_setup >/dev/null || return 1
	[ -n "${INSTALLED_TABLE:-}" ] || build_installed_table "$@" || return 1
	release_file=$(fetch_release) || return 1
	tag=$(jsonfilter -i "$release_file" -e '@.tag_name' 2>/dev/null)
	urls=$(mktemp /tmp/honk-urls.XXXXXX) || { rm -f "$release_file"; return 1; }
	jsonfilter -i "$release_file" -e '@.assets[*].browser_download_url' > "$urls" 2>/dev/null
	rm -f "$release_file"
	[ -n "$tag" ] || { rm -f "$urls"; return 1; }

	# 已装的 luci-app-honk 版本代表"整套"，先跟 tag 比一次；不新就直接返回
	installed=$(awk '$1 == "luci-app-honk" { print $2; exit }' "$INSTALLED_TABLE")
	[ -n "$installed" ] || { rm -f "$urls"; return 1; }
	tag_words=$(version_cmp "$installed" "$tag")

	# 逐个包比：版本从资产文件名里取（GitHub 只会把 ~ + 换成 .，version_cmp 会归一化）
	for name in "$@"; do
		[ "$name" = "vmlinux-btf" ] && continue
		current=$(awk -v n="$name" '$1 == n { print $2; exit }' "$INSTALLED_TABLE")
		[ -n "$current" ] || continue
		url=$(awk -v n="$name" -v a="$REPO_ARCH" '
			{ b = $0; sub(/.*\//, "", b) }
			index(b, n "-") == 1 && b ~ ("-" a "[.]apk$") { print; exit }' "$urls")
		[ -n "$url" ] || continue
		base=${url##*/}
		version=${base#"$name-"}
		version=${version%-"$REPO_ARCH".apk}
		[ -n "$version" ] || continue
		if [ "$(version_cmp "$current" "$version")" = "-1" ]; then
			printf '%s	%s	%s\n' "$name" "$version" "$url"
		elif [ "$tag_words" = "-1" ] && [ "$name" != "honk" ]; then
			# 资产名里的版本比不出来，但整套(release tag)更新了 → 仍然重装这个包
			[ "$(version_cmp "$current" "$version")" = "0" ] &&
				printf '%s	%s	%s\n' "$name" "$version" "$url"
		fi
	done
	rm -f "$urls"
}

check_updates() {
	repo_setup || fail 'Unable to determine the package source.'
	release_file=$(fetch_release) || fail 'Unable to reach the GitHub releases API.'
	tag=$(jsonfilter -i "$release_file" -e '@.tag_name' 2>/dev/null)
	rm -f "$release_file"
	[ -n "$tag" ] || fail 'Unexpected GitHub releases API response.'

	build_installed_table "$@" || fail 'Unable to query installed packages.'

	json_init
	json_add_string source "$(gh_proxy)https://api.github.com/repos/$HONK_GH_REPO/releases"
	json_add_string release "$tag"
	json_add_string arch "$REPO_ARCH"
	json_add_boolean signed "$REPO_SIGNED"
	json_add_array packages
	updates=$(release_updates "$@") || updates=
	while IFS="	" read -r name version url; do
		[ -n "$name" ] || continue
		json_add_object
		json_add_string name "$name"
		json_add_string version "$version"
		json_add_string installed "$(awk -v n="$name" '$1 == n { print $2; exit }' "$INSTALLED_TABLE")"
		json_add_string url "$url"
		json_close_object
	done <<EOF
$updates
EOF
	json_close_array
	json_dump
	rm -f "$INSTALLED_TABLE"
}

# passwall 的安装方式：把 release 里的 .apk 下到临时目录，再 apk add --allow-untrusted。
# 依赖（kmod、v2ray-geoip 等）还是由 apk 从已配置的源里解析。
install_from_release() {
	dir=$(mktemp -d /tmp/honk-update.XXXXXX) || return 1
	list=$(release_updates "$@") || { rm -rf "$dir"; return 1; }
	if [ -z "$list" ]; then
		printf '%s\n' 'Nothing to download: the installed versions are current.'
		rm -rf "$dir"
		return 0
	fi
	printf '%s\n' "$list" > "$dir/list"
	failed=0
	while IFS="	" read -r name version url; do
		[ -n "$url" ] || continue
		printf 'Downloading %s %s\n' "$name" "$version"
		if ! wget -q -T 300 -O "$dir/$name.apk" "$url"; then
			printf 'Failed to download %s\n' "$url"
			failed=1
		fi
	done < "$dir/list"
	if [ "$failed" -ne 0 ]; then
		rm -rf "$dir"
		return 1
	fi
	/usr/bin/apk --interactive=no --progress=no --force-missing-repositories \
		add --allow-untrusted "$dir"/*.apk
	code=$?
	rm -rf "$dir"
	return $code
}

write_result() {
	result_file=$(mktemp /tmp/honk-pkg.XXXXXX) || return 1
	if printf '%s\n' "$1" > "$result_file" && mv -f "$result_file" "$RC"; then
		return 0
	fi
	rm -f "$result_file"
	return 1
}

status() {
	# The inherited descriptor covers both the worker shell and apk. Unlike a
	# saved PID, its lock cannot survive a dead worker or refer to a reused PID.
	exec 8>>"$LOCK" || fail 'Unable to open the package lock.'
	running=1
	flock -n 8 && running=0

	if [ -s "$STATE" ]; then
		state_data=$(cat "$STATE") || fail 'Unable to read package state.'
		load_json "$state_data" || fail 'Invalid package state.'
		if [ "$running" -eq 0 ] && [ ! -f "$RC" ]; then
			printf '%s\n' 'Upgrade worker exited without reporting its status.' >> "$LOG"
			write_result 1 || fail 'Unable to record the interrupted upgrade.'
		fi
	else
		json_init
		json_add_null id
		json_add_string app ''
		json_add_array packages
		json_close_array
		json_add_array before
		json_close_array
	fi

	json_add_boolean running "$running"
	json_add_boolean already_running "${1:-0}"
	if [ "$running" -eq 0 ] && [ -f "$RC" ] && [ -s "$STATE" ]; then
		IFS= read -r result < "$RC" || result=1
		case "$result" in
			''|*[!0-9]*) result=1 ;;
		esac
		json_add_int code "$result"
	else
		json_add_null code
	fi
	log=
	[ ! -f "$LOG" ] || log=$(tail -c 16384 "$LOG" 2>/dev/null)
	json_add_string log "$log"
	# Keep a successful probe locked until its state snapshot is assembled.
	exec 8>&-
	json_dump
}

# New geo data is only read when the service reloads, and upgrading the geo
# packages alone runs no postinst that restarts it. A reload keeps established
# connections and does nothing while the service is stopped. honk's own geodata
# updater writes into its data directory, which takes precedence over these
# packaged files once it has run.
reload_assets() {
	app=$1
	shift
	case " $* " in
		*" v2ray-geoip "*|*" v2ray-geosite "*) ;;
		*) return 0 ;;
	esac
	# The engine's own upgrade already restarted it.
	case " $* " in
		*" $app "*) return 0 ;;
	esac
	[ -x "/etc/init.d/$app" ] || return 0
	"/etc/init.d/$app" enabled || return 0
	printf '%s\n' "Reloading $app so that it reads the new geo data."
	"/etc/init.d/$app" reload
}

# 本仓库的 apk 源：写 /etc/apk/repositories.d/honk.list，并把签名公钥放进
# /etc/apk/keys。之后 apk 的 update / add / upgrade 都走它自己的签名校验。
repo_setup() {
	REPO_ARCH=$(sed -n "s/^DISTRIB_ARCH='\(.*\)'/\1/p" /etc/openwrt_release 2>/dev/null | head -n 1)
	[ -n "$REPO_ARCH" ] || fail 'Unable to detect the device architecture.'
	REPO_URL="$HONK_REPO_BASE/$REPO_ARCH/packages.adb"

	mkdir -p "$APK_KEYS_DIR" "$(dirname "$HONK_REPO_FILE")" ||
		fail 'Unable to create the apk directories.'
	printf '%s\n' "$REPO_URL" > "$HONK_REPO_FILE" ||
		fail "Unable to write $HONK_REPO_FILE."

	REPO_SIGNED=0
	pem="$APK_KEYS_DIR/honk.pem"
	if [ -s "$pem" ]; then
		REPO_SIGNED=1
	elif wget -q -T 20 -O "$pem.tmp" "$HONK_REPO_BASE/key-build.pem" 2>/dev/null &&
		grep -q 'BEGIN PUBLIC KEY' "$pem.tmp"; then
		mv -f "$pem.tmp" "$pem" && REPO_SIGNED=1
	else
		# 公钥拿不到就当未签名源，apk 会报 UNTRUSTED，check 里的 warning 会带出来
		rm -f "$pem.tmp"
	fi
}


upgrade() {
	action=$1
	app=$2
	shift 2
	exec 9>>"$LOCK" || fail 'Unable to open the package lock.'
	if ! flock -n 9; then
		exec 9>&-
		status 1
		return
	fi

	if [ "$action" = install ]; then
		# 还没装，没有 before 可查
		json_init
		json_add_array before
		json_close_array
	else
		before=$(query_installed "$@") || fail 'Unable to query installed packages.'
		load_json "{\"before\":$before}" || fail 'Invalid apk query response.'
	fi
	json_add_string app "$app"
	json_add_string action "$action"
	json_add_string id "$(date +%s)-$$"
	json_add_array packages
	for package in "$@"; do
		json_add_string '' "$package"
	done
	json_close_array
	state_file=$(mktemp /tmp/honk-pkg.XXXXXX) || fail 'Unable to create package state.'
	if ! json_dump > "$state_file" || ! mv -f "$state_file" "$STATE"; then
		rm -f "$state_file"
		fail 'Unable to save package state.'
	fi
	log_file=$(mktemp /tmp/honk-pkg.XXXXXX) || fail 'Unable to create the upgrade log.'
	if ! mv -f "$log_file" "$LOG"; then
		rm -f "$log_file"
		fail 'Unable to reset the upgrade log.'
	fi
	rm -f "$RC" || fail 'Unable to reset the upgrade result.'

	# Redirect all rpcd pipes before forking apk. Descriptor 9 stays inherited,
	# so another tab cannot start a transaction while this worker is alive.
	(
		trap '' HUP
		# 和 passwall 一样：下载 release 里的 .apk，再 apk add --allow-untrusted
		install_from_release "$@"
		code=$?
		[ "$code" -ne 0 ] || reload_assets "$app" "$@"
		write_result "$code"
	) </dev/null >>"$LOG" 2>&1 &
	exec 9>&-
	status 0
}

[ "$#" -gt 0 ] || fail 'A command is required.'
command=$1
shift
case "$command" in
	installed|check)
		[ "$#" -eq 1 ] || fail 'Exactly one application is required.'
		valid_app "$1" || fail 'Invalid application.'
		app=$1
		set -- "$app" "luci-app-$app" \
			luci-i18n-$app-zh-cn luci-i18n-$app-zh-tw \
			v2ray-geoip v2ray-geosite
		if [ "$command" = installed ]; then
			query_installed "$@"
		else
			check_updates "$@"
		fi
		;;
	upgrade)
		[ "$#" -ge 2 ] && [ "$#" -le 8 ] || fail 'An application and one to seven packages are required.'
		valid_app "$1" || fail 'Invalid application.'
		app=$1
		shift
		seen=' '
		for package in "$@"; do
			valid_package "$package" || fail 'Invalid package.'
			case "$seen" in
				*" $package "*) fail 'Duplicate package' ;;
			esac
			seen="$seen$package "
		done
		upgrade upgrade "$app" "$@"
		;;
	install)
		# 一键安装：配好本仓库的 apk 源，然后后台 apk add，前端轮询 status
		[ "$#" -eq 1 ] || fail 'Exactly one application is required.'
		valid_app "$1" || fail 'Invalid application.'
		app=$1
		repo_setup || fail 'Unable to set up the package source.'
		set -- "$app" "luci-app-$app" \
			luci-i18n-$app-zh-cn luci-i18n-$app-zh-tw
		upgrade install "$app" "$@"
		;;
	status)
		[ "$#" -eq 0 ] || fail 'Status takes no arguments.'
		status 0
		;;
	*) fail 'Invalid command.' ;;
esac
